# LLM API Keys
# Get Gemini API key at: https://aistudio.google.com/
GEMINI_API_KEY="your-gemini-api-key-here"

# Optional alternative LLM providers
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""

# Gmail API OAuth 2.0 Credentials (for nillohitfreelanceco@gmail.com)
# Download client_secret.json from Google Cloud Console (APIs & Services > Credentials > OAuth 2.0 Client IDs > Desktop app)
GOOGLE_CLIENT_SECRET_FILE="credentials.json"
GOOGLE_TOKEN_FILE="token.json"

# Safety: Set to True for simulated sending (no actual emails sent)
# Set to False only when ready to send live emails
DRY_RUN="True"

# Remote Access Security: Optional password for accessing the web dashboard
DASHBOARD_PASSWORD="change-this-to-a-secure-team-password"
