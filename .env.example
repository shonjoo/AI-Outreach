# LLM API Keys
# Get Gemini API key at: https://aistudio.google.com/
GEMINI_API_KEY="your-gemini-api-key-here"

# Optional alternative LLM providers
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""

# Gmail API OAuth 2.0 Credentials (for nillohitfreelanceco@gmail.com)
# Download client_secret.json from Google Cloud Console (APIs & Services > Credentials > OAuth 2.0 Client IDs > Desktop app)
GOOGLE_CLIENT_SECRET_FILE="credentials.json"
GOOGLE_TOKEN_FILE="token.json"

# Safety: Set to True for simulated sending (no actual emails sent)
# Set to False only when ready to send live emails
DRY_RUN="True"

# Remote Access Security: Secret Link Token & Password Gate
# If set, users can access directly via link: https://your-domain.streamlit.app/?token=your-secret-token
DASHBOARD_ACCESS_TOKEN="your-secret-token-here"
DASHBOARD_PASSWORD="change-this-to-a-secure-team-password"

# Database Configuration (Supabase Cloud)
# Get your project URL and keys from: https://supabase.com/dashboard/project/_/settings/api
DB_BACKEND="auto" # Options: auto, supabase, sqlite
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_KEY="your-anon-or-service-role-key"
SUPABASE_SERVICE_ROLE_KEY="" # Optional: for backend administrative tasks

